# StyleSync AI — Supabase Environment Configuration
# Copy this file to .env and insert your project credentials from your Supabase dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public)

# Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Publishable Anon Key (public API key safe for browser use with Row Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
